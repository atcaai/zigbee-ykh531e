# Import the unified module components
from ykh531e import YKH531EClimateState, build_ykh531e_packet, parse_ykh531e_packet
from packet_to_timings import packet_to_timings
from broadlink_to_tuya import encode_raw_ir
#from encode_34 import encode_34

# 1. Create and configure a target state
state = YKH531EClimateState()
state.mode = "cool"
state.target_temperature = 22.0
state.fan_mode = "medium"
state.swing_mode = "off"
state.transmit_fahrenheit = False

# 2. Build the 13-byte IR packet for transmission
packet = build_ykh531e_packet(state)
print("Generated IR Packet (Hex):", packet.hex(" ").upper())

# 3. Convert the packet into a Tuya and Zosung Zigbee IR devices coded raw timing array from the ir_message bytearray 
packet = build_ykh531e_packet(state)
raw_timings = packet_to_timings(packet)
print("Generated IR timing code (Raw):", raw_timings)

# 4. Convert raw timings into Tuya's compressed Base64 format using the utility function
# Note: encode_tuya_ir typically accepts a list of integers representing the timing pulses
# singlage packet
zosung_base64_payload = encode_raw_ir(raw_timings)
#zosung_base64_payload = encode_34(packet)
#
# Multi packet
#multi_frame_packet = packet + packet
#zosung_multi_payload = encode_34(multi_frame_packet)

print("Zosung Payload to send via Zigbee:", zosung_base64_payload)
#print("Zosung Payload to send via Zigbee:", zosung_multi_payload)
print("Zosung Payload reference / Zigbee:BzQjdBErAp8GgAPgBwHAF+ADB0AB4AcP4AsB4Bsj4BcBQEPgLwHgMzvgGwHgI1/gFytAH0ADQAFAB0ADCysCKwIrAisCnwYrAg==")


# 5. Parse an incoming packet back into a state object
decoded_state = parse_ykh531e_packet(packet)
if decoded_state:
    print(f"Decoded Mode: {decoded_state.mode}")
    print(f"Decoded Target Temp: {decoded_state.target_temperature}°C")
